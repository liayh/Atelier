{
  "name": "atelier-implantation",
  "productName": "Atelier d'implantation",
  "version": "1.5.0",
  "description": "Implantation réseau sur plans : bornes WiFi, caméras, prises RJ45, baie, fibre et longueurs de câble.",
  "author": "devben",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "sync": "node scripts/sync-web.js",
    "icon": "electron scripts/make-icon.js",
    "start": "npm run sync && electron .",
    "dist:win": "npm run sync && bash scripts/build-win.sh",
    "dist:linux": "npm run sync && electron-builder --linux AppImage deb --x64"
  },
  "build": {
    "appId": "fr.devben.atelierimplantation",
    "productName": "Atelier d'implantation",
    "executableName": "AtelierImplantation",
    "artifactName": "Atelier-implantation-Setup-${version}.${ext}",
    "files": [
      "src/**/*",
      "web/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Atelier d'implantation",
      "language": "1036"
    },
    "fileAssociations": [
      {
        "ext": "atelier",
        "name": "AtelierImplantation.Projet",
        "description": "Projet Atelier d'implantation",
        "icon": "icon.ico",
        "role": "Editor",
        "mimeType": "application/x-atelier-implantation"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "executableName": "atelier-implantation",
      "icon": "build/icon.png",
      "category": "Office;Engineering",
      "synopsis": "Implantation réseau sur plans : WiFi, caméras, RJ45, câblage, chiffrage",
      "maintainer": "liayh <liayh@users.noreply.github.com>",
      "artifactName": "Atelier-implantation-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Atelier d'implantation",
          "Comment": "Implantation réseau sur plans",
          "StartupWMClass": "atelier-implantation"
        }
      }
    }
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "pdfjs-dist": "^3.11.174"
  },
  "homepage": "https://github.com/liayh/Atelier"
}
